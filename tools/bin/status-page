#!/usr/bin/env php
<?php

/**
 * Builds the public hash page: for every shipped patch, the sha256 Adobe publishes,
 * the value in our .sha256 file, and the hash of the file itself.
 *
 * Usage: tools/bin/status-page <output-dir>
 * Writes <output-dir>/index.html and <output-dir>/status.json.
 * Exit code: 0 every patch matches, 2 any mismatch (the page is still written).
 */

declare(strict_types=1);

use DeployEcommerce\CommunityPatches\Tools\Http;
use DeployEcommerce\CommunityPatches\Tools\Registry;

$root = dirname(__DIR__, 2);
require $root . '/vendor/autoload.php';

$out = $argv[1] ?? '';
if ($out === '') {
    fwrite(STDERR, "Usage: tools/bin/status-page <output-dir>\n");
    exit(1);
}
@mkdir($out, 0777, true);

$repository = getenv('GITHUB_REPOSITORY') ?: 'DeployEcommerce/magento-community-patches';
$commit = getenv('GITHUB_SHA') ?: trim((string) shell_exec('git -C ' . escapeshellarg($root) . ' rev-parse HEAD 2>/dev/null'));
$checkedAt = gmdate('Y-m-d\TH:i:s\Z');
$registry = Registry::fetch(new Http());
$manifest = json_decode((string) file_get_contents($root . '/patches.json'), true, 512, JSON_THROW_ON_ERROR);

$rows = [];
foreach ($manifest['patches'] as $patch) {
    $file = $root . '/' . $patch['file'];
    $sidecar = is_file($file . '.sha256') ? (string) strtok((string) file_get_contents($file . '.sha256'), ' ') : null;
    $computed = is_file($file) ? hash_file('sha256', $file) : null;
    $entry = $registry->get($patch['id']);
    $adobe = $entry['sha256'] ?? null;

    if ($entry === null) {
        $status = 'NOT_IN_REGISTRY';
    } elseif (!empty($entry['entitlements']) || ($entry['area'] ?? null) !== 'CE') {
        $status = 'NO_LONGER_UNRESTRICTED_CE';
    } elseif ($adobe === $sidecar && $sidecar === $computed) {
        $status = 'MATCH';
    } else {
        $status = 'MISMATCH';
    }

    $rows[] = [
        'id' => $patch['id'],
        'applies_to' => $patch['applies_to'],
        'cves' => $patch['cves'] ?? [],
        'released' => $patch['released'] ?? null,
        'adobe_sha256' => $adobe,
        'sha256_file' => $sidecar,
        'computed_sha256' => $computed,
        'status' => $status,
        'file' => $patch['file'],
        'raw_url' => sprintf('https://raw.githubusercontent.com/%s/%s/%s', $repository, $commit ?: 'main', $patch['file']),
        'adobe_url' => $registry->downloadUrl($patch['id']),
    ];
}

$failures = array_values(array_filter($rows, static function (array $row): bool {
    return $row['status'] !== 'MATCH';
}));
file_put_contents($out . '/status.json', json_encode([
    'checked_at' => $checkedAt,
    'registry' => Registry::URL,
    'commit' => $commit,
    'all_match' => $failures === [],
    'patches' => $rows,
], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");

$e = static function (?string $value): string {
    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_HTML5, 'UTF-8');
};
$body = '';
foreach ($rows as $row) {
    $ok = $row['status'] === 'MATCH';
    $body .= sprintf(
        "<tr class=\"%s\"><td><a href=\"%s\">%s</a></td><td>%s</td><td>%s</td><td>%s</td>"
        . "<td><code>%s</code></td><td><code>%s</code></td><td><code>%s</code></td><td>%s</td></tr>\n",
        $ok ? 'ok' : 'bad',
        $e($row['raw_url']),
        $e($row['id']),
        $e(implode(', ', $row['applies_to'])),
        $e($row['released']),
        $e(implode(', ', $row['cves'])),
        $e($row['adobe_sha256']),
        $e($row['sha256_file']),
        $e($row['computed_sha256']),
        $ok ? '&#10003; match' : '&#10007; ' . $e(strtolower(str_replace('_', ' ', $row['status'])))
    );
}
$summary = $failures === []
    ? sprintf('All %d patches match the sha256 Adobe publishes.', count($rows))
    : sprintf('%d of %d patches do not match. See the rows marked in red.', count($failures), count($rows));

file_put_contents($out . '/index.html', <<<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Magento Community Patches: hash check</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 75rem; padding: 0 1rem; color: #1a1a1a; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { border-bottom: 1px solid #ddd; padding: .4rem .5rem; text-align: left; vertical-align: top; }
  td code { word-break: break-all; font-size: 11px; }
  tr.ok td:last-child { color: #116329; }
  tr.bad td { background: #ffebe9; }
  .summary { font-weight: 600; }
  @media (prefers-color-scheme: dark) {
    body { background: #0d1117; color: #e6edf3; } a { color: #58a6ff; }
    th, td { border-color: #30363d; } tr.bad td { background: #3d1418; } tr.ok td:last-child { color: #3fb950; }
  }
</style>
</head>
<body>
<h1>Magento Community Patches: hash check</h1>
<p class="summary">{$e($summary)}</p>
<p>Every patch shipped by <a href="https://github.com/{$e($repository)}"><code>deployecommerce/magento-community-patches</code></a> is compared with the sha256 that Adobe publishes for it in its <a href="{$e(Registry::URL)}">patch registry</a>. <strong>Adobe</strong> is the registry value, <strong>.sha256 file</strong> is the hash committed next to the patch, and <strong>Computed</strong> is the hash of the committed patch file itself.</p>
<p>Checked {$e($checkedAt)} against commit <code>{$e($commit)}</code>. Machine-readable: <a href="status.json">status.json</a>.</p>
<table>
<thead><tr><th>Patch</th><th>Magento Open Source</th><th>Released</th><th>CVEs</th><th>Adobe sha256</th><th>.sha256 file</th><th>Computed</th><th>Status</th></tr></thead>
<tbody>
{$body}</tbody>
</table>
<h2>Check it yourself</h2>
<p>Hash a patch from this repository and compare it with Adobe's own copy and registry entry:</p>
<pre><code>curl -sL https://raw.githubusercontent.com/{$e($repository)}/main/patches/248p5-2026-10-001-CE.patch | sha256sum
curl -sL https://repo.magento.com/patch/248p5-2026-10-001-CE.diff | sha256sum
curl -sL https://repo.magento.com/patch/patch-registry.json | jq -r '.patches["248p5-2026-10-001-CE"].sha256'</code></pre>
<h2>What a match does and does not prove</h2>
<p>A match means the patch file in this repository is byte-for-byte the file Adobe's registry described when this page was built. It does not prove the patch is correct or complete, and it cannot detect a change to Adobe's registry itself. The <strong>.sha256 file</strong> and <strong>Computed</strong> columns come from this repository, so only the <strong>Adobe</strong> column is independent of it. Releases also carry GitHub build provenance attestations, which tie each release to the commit and workflow that built it.</p>
<p>This project is not affiliated with Adobe. The patches are Adobe's work, redistributed unmodified under the Open Software License 3.0.</p>
</body>
</html>

HTML
);

echo $summary, "\n";
foreach ($failures as $row) {
    echo "FAIL {$row['id']}: {$row['status']}\n";
}
exit($failures === [] ? 0 : 2);
