#!/usr/bin/env php
<?php

/**
 * Syncs patches/ and patches.json with Adobe's patch registry.
 *
 * Usage: tools/bin/sync [--dry-run]
 * Exit code: 0 no changes, 10 changes written (or would be, with --dry-run), 1 error.
 */

declare(strict_types=1);

use DeployEcommerce\CommunityPatches\Tools\CePackages;
use DeployEcommerce\CommunityPatches\Tools\Gate;
use DeployEcommerce\CommunityPatches\Tools\Http;
use DeployEcommerce\CommunityPatches\Tools\Registry;
use DeployEcommerce\CommunityPatches\Tools\Sync;

$root = dirname(__DIR__, 2);
require $root . '/vendor/autoload.php';

$write = !in_array('--dry-run', $argv, true);

try {
    $http = new Http();
    $registry = Registry::fetch($http);
    $result = (new Sync($registry, new Gate($registry, $http, new CePackages($http)), $root))->run($write);
} catch (\Throwable $e) {
    fwrite(STDERR, 'sync failed: ' . $e->getMessage() . "\n");
    exit(1);
}

foreach ($result['added'] as $id) {
    echo "added    $id\n";
}
foreach ($result['removed'] as $id) {
    echo "removed  $id\n";
}
foreach ($result['reissued'] as $id => $sha256) {
    echo "reissued $id: Adobe changed this patch; the old version (sha256 $sha256) is kept in patches/superseded/\n";
}
foreach ($result['rejected'] as $id => $reason) {
    echo "skipped  $id: $reason\n";
}

exit($result['added'] === [] && $result['removed'] === [] && $result['reissued'] === [] ? 0 : 10);
