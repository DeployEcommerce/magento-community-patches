#!/usr/bin/env php
<?php

/**
 * Checks the committed patches against themselves and against Adobe's live registry:
 *  - every patches.json entry has its file and .sha256, and all three hashes agree
 *  - the hash also matches the sha256 Adobe publishes for that patch id
 *  - the registry still lists it as an unrestricted Magento Open Source patch
 *  - every patch it requires is shipped too
 *  - patches/ holds nothing patches.json does not list, apart from superseded/ (old versions Adobe re-issued)
 *
 * Exit code: 0 all good, 1 any problem.
 */

declare(strict_types=1);

use DeployEcommerce\CommunityPatches\Manifest;
use DeployEcommerce\CommunityPatches\Tools\Http;
use DeployEcommerce\CommunityPatches\Tools\Registry;

$root = dirname(__DIR__, 2);
require $root . '/vendor/autoload.php';

$problems = [];
$data = json_decode((string) file_get_contents($root . '/patches.json'), true, 512, JSON_THROW_ON_ERROR);
new Manifest($data['patches']);
$registry = Registry::fetch(new Http());

$listed = [];
$ids = array_column($data['patches'], 'id');
foreach ($data['patches'] as $patch) {
    $id = $patch['id'];
    $file = $root . '/' . $patch['file'];
    $listed[] = realpath($file) ?: $file;
    $listed[] = realpath($file . '.sha256') ?: $file . '.sha256';

    $entry = $registry->get($id);
    $actual = is_file($file) ? hash_file('sha256', $file) : null;
    $sidecar = is_file($file . '.sha256') ? trim((string) file_get_contents($file . '.sha256')) : null;

    if ($actual === null) {
        $problems[] = "$id: patch file missing";
    } elseif ($actual !== $patch['sha256']) {
        $problems[] = "$id: file hash $actual does not match patches.json";
    }
    if ($sidecar !== sprintf('%s  %s', $patch['sha256'], basename($file))) {
        $problems[] = "$id: .sha256 file missing or does not match patches.json";
    }
    if ($entry === null) {
        $problems[] = "$id: no longer in Adobe's registry";
        continue;
    }
    if ($entry['sha256'] !== $patch['sha256']) {
        $problems[] = "$id: Adobe's registry now lists sha256 {$entry['sha256']}";
    }
    if (substr($id, -3) !== '-CE' || ($entry['area'] ?? null) !== 'CE' || !empty($entry['entitlements'])) {
        $problems[] = "$id: the registry no longer lists it as an unrestricted Magento Open Source patch";
    }
    foreach ((array) ($entry['requires'] ?? []) as $required) {
        if (!in_array($required, $ids, true)) {
            $problems[] = "$id: requires $required, which is not shipped";
        }
    }
    if (array_diff($patch['applies_to'], (array) $entry['applies_to']) !== []) {
        $problems[] = "$id: applies_to lists releases the registry does not";
    }
}

foreach (glob($root . '/patches/*') ?: [] as $file) {
    if (!in_array(realpath($file), $listed, true) && !in_array(basename($file), ['.gitkeep', 'superseded'], true)) {
        $problems[] = 'unexpected file patches/' . basename($file);
    }
}

foreach ($problems as $problem) {
    echo "FAIL $problem\n";
}
echo $problems === [] ? sprintf("OK: %d patches verified against Adobe's registry.\n", count($data['patches'])) : '';
exit($problems === [] ? 0 : 1);
